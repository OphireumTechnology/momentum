# Server-side Gemini API key for rate calculation, dispatch assistance, and customer support
GEMINI_API_KEY=

# Centralized Email Delivery Configuration
# Official receiving email address for all website inquiries, quotes, applications, and support:
OFFICIAL_RECIPIENT_EMAIL=wright.wendell@icloud.com

# SMTP Delivery Provider Configuration (Optional: when set, live emails are transmitted; otherwise safely queued in audit store)
# Example for iCloud Mail:
# SMTP_HOST=smtp.mail.me.com
# SMTP_PORT=587
# SMTP_USER=wright.wendell@icloud.com
# SMTP_PASS=your-icloud-app-specific-password
# SMTP_SECURE=false
# EMAIL_FROM="Momentum Transportation" <wright.wendell@icloud.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=

# Frontend API base URL (for static deployments such as GitHub Pages pointing to this backend)
# Example: https://momentum-api.yourdomain.com
VITE_API_BASE_URL=
